//Spread With Arrays

//Without Spread 
const original = [1,2,3,4,5];
const badCopy = original;
badCopy.push(10);
console.log(original);
console.log(badCopy);

//With Spread
const original2 = [11,12,13,14,15];
const goodCopy = [...original2];
goodCopy.push(50);
console.log(original2);
console.log(goodCopy);



//Combining two arrays into a new array
const arr1 = [1,2,3,4,5];
const arr2 = [6,7,8,9,10];
const result = [...arr1, ...arr2 , "End"];
console.log(result);



//Spread With Objects

//copying an Object
const user = {
    name:"Alice",
    age:25
};
const newUser = {...user};
//Adding a new property without changing the original
newUser.country = "Paris";
console.log(newUser);
console.log(user);

//Merge Two Objects
const existingProfile = {
    name:"Ali",
    age:19,
    city:"Paris"
};
const updatedProfile = {
    age:21,
    city:"Spain",
    email:"...@gmail.com"
};
const newProfile = {...existingProfile, ...updatedProfile};
console.log(newProfile);
//Object Destructuring
const {name:NewName,city:NewCity,email:NewEmail,age:NewAge,phoneNumber="12345"} = newProfile;
console.log(NewName);
console.log(NewCity);
console.log(NewEmail);
console.log(NewAge);
console.log(phoneNumber);



//Shallow Copy
const user3 = {
    name:"Alice",
    age:21,
    address:{
        city:"NewYork",
        country:"USA"
    },
    email:"abc@gmail.com"
};
// const copyUser3 = {...user3};
//changing a top level propert will not affect the original
// copyUser3.name="Mr. Alice";
// console.log(copyUser3);
// console.log(user3);
//Changing a nested property will also affect the original one.
// copyUser3.address.city="Sydne";
// console.log(copyUser3);
// console.log(user3);


//So here is the solution.
//To safely update a nested property
const copyUser3 = {...user3, address:{...user3.address,city:"Sydne"}};
console.log(copyUser3);
// copyUser3.address.city="Sydne";
console.log(copyUser3);
console.log(user3);





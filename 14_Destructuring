//Object Destructuring
//Old Way 
const user = {
    name:"Ali",
    age:19,
    email:"..@gmail.com"
};
const Name = user.name;
const Age = user.age;
const Email = user.email;

console.log(Name);
console.log(Age);
console.log(Email);

//Modern Way
const USER = {
    name:"Husnain",
    age:18,
    email:".@gmail.com"
};
const {name,age,email} = USER;
//the variables names inside {} must match the key namesi the object Exactly. Otherwise it will show "undefined"

console.log(name);
console.log(age);
console.log(email);


//We can pickup and chose only what we want
const PROFILE = {
    NAME : "Husnain Ahmad",
    AGE:20,
    EMAIL:"demo@gmail.com"
};
const {NAME,EMAIL} = PROFILE;
console.log(NAME);
console.log(EMAIL);



//Renaming while Destructuring
const user2 = {
    name:"Ali",
    age:19,
    email:"husnain@gmail.com"
};
// const {name,age,email} = user2; //shows error because the variables name,age and email has alreday been taken.
//So the solution is "Renaming while destructuring"
const {name:UserName,email:UserEmail} = user2;
console.log(UserName);
console.log(UserEmail);




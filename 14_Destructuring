//Destructuring (used in React)
//Array Destructuring


// Without Array Destructuring - Old Way
const arr = [1,2,3,4,5];
const one = arr[0];
const two = arr[1];
const three = arr[2];

console.log(one);
console.log(two);
console.log(three);


//With Array Destructuring - ES6+ Syntax - Modern Way
const array = [11,12,13,14,15];
const [first,second,third,fourth,fifth] = array;
console.log(first);
console.log(second);
console.log(third);
console.log(fourth);
console.log(fifth);



//RGB Color Example
const color = [122,90,255];
const [R,G,B] =color;
console.log(R);
console.log(G);
console.log(B);



//SKip value
// Use a comma with no variable name to SKIP a position
const A = [1,2,3,4,5];
const [ , , , l2,l]=A;
console.log(l2);
console.log(l);



//Object Destructuring
//Old Way 
const user = {
    name:"Ali",
    age:19,
    email:"..@gmail.com"
};
const Name = user.name;
const Age = user.age;
const Email = user.email;

console.log(Name);
console.log(Age);
console.log(Email);

//Modern Way
const USER = {
    name:"Husnain",
    age:18,
    email:".@gmail.com"
};
const {name,age,email} = USER;
//the variables names inside {} must match the key namesi the object Exactly. Otherwise it will show "undefined"

console.log(name);
console.log(age);
console.log(email);


//We can pickup and chose only what we want
const PROFILE = {
    NAME : "Husnain Ahmad",
    AGE:20,
    EMAIL:"demo@gmail.com"
};
const {NAME,EMAIL} = PROFILE;
console.log(NAME);
console.log(EMAIL);

//With Array Destructuring - ES6+ Syntax - Modern Way
const array = [11,12,13,14,15];
const [first,second,third,fourth,fifth] = array;
console.log(first);
console.log(second);
console.log(third);
console.log(fourth);
console.log(fifth);



